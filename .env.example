# Free key from https://console.groq.com/keys (no card needed). Copy this file to .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: require this access key for the API (X-API-Key header). Leave empty for local use.
API_KEY=


# Optional: a key per approver role, so one role cannot approve as another.
# APPROVER_KEYS=Department Head=change-me;Finance Controller=change-me;CFO=change-me;CIO=change-me;Line Manager=change-me
